# Copy to .env for local overrides. Never commit .env.
# Keep comments on their own lines: the Makefile includes this file.

EINSORA_ENV=dev
EINSORA_HTTP_ADDR=127.0.0.1:8080
EINSORA_LOG_LEVEL=info
# Optional: also append every log line to this file (created with owner-only permissions).
EINSORA_LOG_FILE=

# Empty = in-memory store (make dev only). sqlite:<path> keeps everything in one file, readable by its
# owner only, in a directory other users can't write to (Solo and Lab, ADR-0012; migrated automatically
# when opened). Use an absolute path for services: their working directory is usually /. A postgres:// URL selects
# Postgres (make dev-pg, Datacenter); run `einsora migrate` first.
EINSORA_DATABASE_URL=

# A catalog file to use instead of the one built into the binary (a copy of images/catalog.yaml).
EINSORA_CATALOG_PATH=

# local | oidc | dev. local: built-in accounts and API tokens (Solo and Lab; create the owner with
# `einsora setup`). oidc: an identity provider (Datacenter). dev trusts X-Dev-Tenant / X-Dev-User
# headers and is refused unless EINSORA_ENV=dev.
EINSORA_AUTH_MODE=dev
# Local auth: passwords and session cookies cross only HTTPS or this machine. Behind a reverse proxy
# that terminates HTTPS, list its own addresses here (comma-separated; a range trusts every address
# in it to claim HTTPS and any client address, so list only the proxies) so its
# X-Forwarded-Proto and X-Forwarded-For are believed; it must send both. Sign-in through a proxy
# that isn't listed is refused, even on this machine. EINSORA_INSECURE_HTTP=true also allows plain
# HTTP from other machines: only on a network you trust.
EINSORA_TRUSTED_PROXIES=
EINSORA_INSECURE_HTTP=false
EINSORA_OIDC_ISSUER=
EINSORA_OIDC_AUDIENCE=einsora-api
EINSORA_OIDC_TENANT_CLAIM=einsora_tenant

# fake | kubernetes | agent. agent: node agents (ADR-0013, ADR-0016); this machine's agent runs in the
# controller's process, owned by the tenant EINSORA_MACHINE_OWNER (the one `einsora setup` made).
# EINSORA_AGENT_DRIVERS: empty runs every driver this machine can: macos-native on Apple Silicon
# with uv, docker on Linux with a local rootful daemon (ADR-0017/0018). sim is for dev only.
EINSORA_CLUSTER_BACKEND=fake
EINSORA_FAKE_CAPACITY=l40s-48gb=4,a100-80gb=2
EINSORA_MACHINE_OWNER=home
EINSORA_AGENT_DRIVERS=
# einsora up keeps all its data here (database, machine identity, workloads, einsora.log). Empty: the usual
# place on this OS (macOS: ~/Library/Application Support/Einsora; Linux: ~/.local/share/einsora).
EINSORA_DATA_DIR=
# Where this machine's ID is kept between starts. Empty: next to the SQLite database. The agent backend runs
# with SQLite until agents join over the network (Phase 2).
EINSORA_AGENT_STATE_DIR=
# Where workloads' Unix sockets go (ADR-0017/0018). Keep the path short (103 bytes including the socket).
# Empty: ~/.einsora/run on macOS; docker-state/run next to the database on Linux.
EINSORA_AGENT_RUN_DIR=
# Local Linux Docker Engine socket. Empty: /var/run/docker.sock. No remote daemons, rootless Docker,
# or userns-remap yet. Requires memory/swap/PID/CPU cgroup limits; NVIDIA also needs its toolkit.
EINSORA_DOCKER_SOCKET=
# Where the access proxy listens (ADR-0017): running notebooks open at w-<id>.localhost on this port, from
# the dashboard's Open button. A loopback address only: *.localhost is always the browser's own machine.
EINSORA_ACCESS_ADDR=127.0.0.1:8090
EINSORA_UNTRUSTED_RUNTIME_CLASS=kata-qemu-nvidia-gpu
EINSORA_STORAGE_CLASS=einsora-block
EINSORA_IMAGES_NAMESPACE=einsora-images

# The one region this process's controller reconciles (ADR-0009). Must be in the catalog's regions.
EINSORA_REGION=local

EINSORA_CONTROLLER_INTERVAL=5s
EINSORA_METERING_INTERVAL=5m

# Dashboard (web/): tenant used for dev-mode auth headers.
VITE_DEV_TENANT=acme

# CLI client (einsora workloads | events <id> | export <id>). Not used by the server.
#   EINSORA_API_URL     default http://127.0.0.1:8080
#   EINSORA_TOKEN       an API token (tsk_…, from the dashboard's API tokens page) or an OIDC token; never commit one
#   EINSORA_DEV_TENANT  tenant slug sent as X-Dev-Tenant (dev mode)
#   EINSORA_INSECURE_HTTP=true  allow sending EINSORA_TOKEN over plain http:// to another machine (off by default;
#                               the server reads the same setting, above)
