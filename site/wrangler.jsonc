// Cloudflare: serves the built site (dist/) as static files, for a Workers project connected to this
// repository (build command `npm run build`, deploy command `npx wrangler deploy`). A Pages project
// doesn't need this file, and skips it.
{
	"name": "einsora",
	"compatibility_date": "2026-10-01",
	// The site's own address is https://einsora.com (a custom domain on the Worker); the workers.dev
	// address stays on as a fallback, and pull requests get preview URLs.
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
